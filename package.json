    "hono": "^4.12.5",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/pg": "^8.11.6",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}